# Plain Postgres (required in production/staging Shape A)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rme_staging
# POSTGRES_URL=  # optional alias
PG_POOL_MAX=10
# PGSSL=require

# Auth JWT (HS256) — use a long random secret
AUTH_JWT_SECRET=

# Public app URL (also used as supabase-js base URL)
NEXT_PUBLIC_APP_URL=https://ronnyandme.com
NEXT_PUBLIC_SUPABASE_URL=https://ronnyandme.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=https://ronnyandme.com
STORAGE_PUBLIC_URL=https://ronnyandme.com
STORAGE_ROOT=/app/storage
STORAGE_SIGNING_SECRET=
# Optional: fetch missing public objects from the old Supabase project
LEGACY_SUPABASE_URL=

# Payments
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_CALLBACK_SECRET=
MOOLRE_SMS_API_KEY=
MOOLRE_SMS_SENDER_ID=

# Optional
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
ADMIN_SMS_NUMBERS=

# Optional PIN for the admin Modules page (checked on the server). Leave empty for no PIN.
MODULES_PIN=

# Chat assistant AI (tried in this order; leave all empty to use the free rule-based assistant)
ANTHROPIC_API_KEY=
# CHAT_CLAUDE_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
GROQ_API_KEY=
# Max AI replies per day per server before the chat switches to the free assistant
# CHAT_AI_DAILY_LIMIT=1500
