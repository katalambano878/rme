# Plain Postgres (required in production/staging Shape A)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rme_staging
# POSTGRES_URL=  # optional alias
PG_POOL_MAX=10
# PGSSL=require

# Auth JWT (HS256) — use a long random secret
AUTH_JWT_SECRET=

# Public app URL (also used as supabase-js base URL)
NEXT_PUBLIC_APP_URL=https://ronnyandme.com
NEXT_PUBLIC_SUPABASE_URL=https://ronnyandme.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=https://ronnyandme.com
STORAGE_PUBLIC_URL=https://ronnyandme.com
STORAGE_ROOT=/app/storage
STORAGE_SIGNING_SECRET=

# Payments
MOOLRE_API_USER=
MOOLRE_API_KEY=
MOOLRE_API_PUBLIC_KEY=
MOOLRE_CALLBACK_SECRET=
MOOLRE_SMS_API_KEY=
MOOLRE_SMS_SENDER_ID=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
ADMIN_SMS_NUMBERS=
