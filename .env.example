# App
NEXT_PUBLIC_APP_URL=
APP_BASE_URL=

# Plain PostgreSQL (required — store_trustecom / fleet)
# Prefer PgBouncer URL at runtime; use DIRECT_URL for migrations/admin scripts.
DATABASE_URL=
DIRECT_URL=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Auth (JWT session cookies — required)
AUTH_SECRET=
AUTH_COOKIE_NAME=trustecom_session
AUTH_COOKIE_MAX_AGE_DAYS=7

# Local disk uploads (replaces Supabase Storage)
UPLOAD_DIR=
NEXT_PUBLIC_UPLOAD_BASE_URL=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Moolre (payments + SMS) — MOOLRE_CALLBACK_SECRET is REQUIRED for callbacks
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_CALLBACK_SECRET=
MOOLRE_MERCHANT_EMAIL=
MOOLRE_API_KEY=
MOOLRE_SMS_API_KEY=
MOOLRE_SMS_SENDER_ID=TrustEcom

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
ADMIN_SMS_NUMBERS=

# AI chat (Groq)
GROQ_API_KEY=

# reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
